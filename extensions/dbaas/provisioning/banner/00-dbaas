#!/bin/sh
# Installed at /etc/update-motd.d/00-dbaas inside each dbaas-* image.
# Both Ubuntu 24.04 and Debian 12 (with the update-motd package installed)
# build the login banner from this directory, so a plain /etc/motd gets
# buried under the stock distro output; running first here is what actually
# puts this in front of the user. /etc/motd is written too, for anything
# that reads it directly.
[ -r /etc/dbaas-engine ] || exit 0
. /etc/dbaas-engine

cat <<'BANNER'

   ____    ___    _
  / ___|  / _ \  | |
  \___ \ | | | | | |
   ___) || |_| | | |___
  |____/  \__\_\ |_____|

  DATABASE SERVICE

BANNER
printf '  Engine  %s\n  Port    %s\n\n' "${DBAAS_ENGINE_NAME}" "${DBAAS_ENGINE_PORT}"
cat <<'BANNER'
  Query and connection details: CloudStack > Database
  Password reset: More > Reset Database Password

BANNER
