[Unit]
Description=Rotate the DBaaS MongoDB admin password on first boot
After=mongod.service
Wants=mongod.service
ConditionPathExists=!/var/lib/dbaas/admin-password-rotated

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/dbaas/rotate-admin-password.sh

[Install]
WantedBy=multi-user.target
